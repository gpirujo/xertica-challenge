# =============================================================================
# LLM
# =============================================================================
# Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# LLM_PROVIDER también controla el modelo de embeddings:
#   openrouter → text-embedding-3-small (dim 1536, vía OpenRouter)
#   vertex     → text-embedding-004     (dim 768,  vía Vertex AI)
# Usar el mismo valor en index time y query time — vectores de distinto modelo no son comparables.
LLM_PROVIDER=openrouter   # openrouter or vertexai
LLM_MODEL=openrouter/auto
# En producción cambiar a: google/gemini-2.0-flash

# =============================================================================
# Observabilidad
# =============================================================================
# Obtener en: https://cloud.langfuse.com (free tier)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Base de datos (local via Docker)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# Elasticsearch
# =============================================================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
# En producción: ELASTICSEARCH_USER y ELASTICSEARCH_PASSWORD

# =============================================================================
# FalkorDB (local via Docker)
# =============================================================================
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# =============================================================================
# GCP (solo producción — dejar vacío en dev)
# =============================================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1

# =============================================================================
# Documentos regulatorios (RAG)
# =============================================================================
DOCS_DIR=docs

# =============================================================================
# Embeddings
# =============================================================================
EMBEDDING_PROVIDER=      # openrouter or vertexai
EMBEDDING_MODEL=         # e.g. text-embedding-3-small or textembedding-gecko
EMBEDDING_DIMENSIONS=    # 1536 for text-embedding-3-small, 768 for textembedding-gecko
GOOGLE_CLOUD_PROJECT=    # GCP project for Vertex AI embeddings
GOOGLE_CLOUD_LOCATION=   # e.g. us-central1
